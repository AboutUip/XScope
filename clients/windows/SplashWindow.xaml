<Window x:Class="XScope.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XScope"
        Width="580"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Focusable="True"
        Icon="pack://application:,,,/Assets/xscope.ico"
        PreviewKeyDown="OnPreviewKeyDown">
            <Border x:Name="RootChrome"
            CornerRadius="22"
            ClipToBounds="True"
            Background="{StaticResource SplashBgBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="0"
                              Opacity="0.3"
                              Color="#1A2A3A" />
        </Border.Effect>
        <Grid>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.38,0.32" RadiusX="1.05" RadiusY="0.9">
                        <GradientStop Color="#FBFDFF" Offset="0" />
                        <GradientStop Color="#E7F0F5" Offset="0.52" />
                        <GradientStop Color="#CDDDE6" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Opacity="0.4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0.3" />
                        <GradientStop Color="#401A6B7A" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Soft living bloom behind the wordmark -->
            <Ellipse x:Name="InkBloom"
                     Width="220"
                     Height="90"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,-24,0,0"
                     Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5526A0B5" Offset="0" />
                        <GradientStop Color="#0026A0B5" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="InkBloomScale" ScaleX="0.4" ScaleY="0.4" CenterX="110" CenterY="45" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Drift motes (life in the air) -->
            <Canvas x:Name="MoteLayer"
                    IsHitTestVisible="False"
                    Opacity="0.55">
                <Ellipse x:Name="Mote0" Width="5" Height="5" Fill="#3A7A8C" Opacity="0" Canvas.Left="90" Canvas.Top="210" />
                <Ellipse x:Name="Mote1" Width="3.5" Height="3.5" Fill="#5A9AAB" Opacity="0" Canvas.Left="420" Canvas.Top="90" />
                <Ellipse x:Name="Mote2" Width="4" Height="4" Fill="#2F6B7C" Opacity="0" Canvas.Left="140" Canvas.Top="70" />
                <Ellipse x:Name="Mote3" Width="3" Height="3" Fill="#6AABB8" Opacity="0" Canvas.Left="470" Canvas.Top="200" />
                <Ellipse x:Name="Mote4" Width="4.5" Height="4.5" Fill="#3D8090" Opacity="0" Canvas.Left="300" Canvas.Top="250" />
            </Canvas>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!--
                  Canvas stage: letters are absolutely placed so collapsed glyphs
                  never leave a hole, and X can slide to the final wordmark origin.
                -->
                <Canvas x:Name="Stage"
                        Width="360"
                        Height="88"
                        ClipToBounds="False">
                    <!-- Temporary Xuan tail (not part of final layout width). -->
                    <TextBlock x:Name="GlyphU" Text="u" Style="{StaticResource SplashSmallLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphUScale" />
                                <RotateTransform x:Name="GlyphURotate" />
                                <TranslateTransform x:Name="GlyphUTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphA" Text="a" Style="{StaticResource SplashSmallLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphAScale" />
                                <RotateTransform x:Name="GlyphARotate" />
                                <TranslateTransform x:Name="GlyphATranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphN" Text="n" Style="{StaticResource SplashSmallLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphNScale" />
                                <RotateTransform x:Name="GlyphNRotate" />
                                <TranslateTransform x:Name="GlyphNTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Final wordmark slots -->
                    <TextBlock x:Name="GlyphX" Text="X" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphXScale" ScaleX="1" ScaleY="1" />
                                <RotateTransform x:Name="GlyphXRotate" />
                                <TranslateTransform x:Name="GlyphXTranslate" />
                                <SkewTransform x:Name="GlyphXSkew" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphS" Text="S" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.85">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphSScale" />
                                <RotateTransform x:Name="GlyphSRotate" />
                                <TranslateTransform x:Name="GlyphSTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphC" Text="c" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.85">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphCScale" />
                                <RotateTransform x:Name="GlyphCRotate" />
                                <TranslateTransform x:Name="GlyphCTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphO" Text="o" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.85">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphOScale" />
                                <RotateTransform x:Name="GlyphORotate" />
                                <TranslateTransform x:Name="GlyphOTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphP" Text="p" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.85">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphPScale" />
                                <RotateTransform x:Name="GlyphPRotate" />
                                <TranslateTransform x:Name="GlyphPTranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="GlyphE" Text="e" Style="{StaticResource SplashLetterStyle}"
                               Canvas.Left="0" Canvas.Top="0" Opacity="0" RenderTransformOrigin="0.5,0.85">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="GlyphEScale" />
                                <RotateTransform x:Name="GlyphERotate" />
                                <TranslateTransform x:Name="GlyphETranslate" />
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>

                <TextBlock x:Name="Tagline"
                           Text="N E T W O R K   R E S E A R C H"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Bahnschrift, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#5A7380"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TaglineTranslate" Y="8" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
