<UserControl x:Class="XScope.Controls.KnowledgeGraph3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource XScopeWindowBg}"
             FocusVisualStyle="{x:Null}"
             Focusable="True">
    <Grid>
        <Grid x:Name="ViewportHost" ClipToBounds="True" />

        <Canvas x:Name="LabelLayer"
                IsHitTestVisible="False"
                ClipToBounds="True" />

        <Border x:Name="Toolbar"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="12,12,12,0"
                Padding="4"
                Background="{DynamicResource XScopeSurfaceAlt}"
                BorderBrush="{DynamicResource XScopeBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="5"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="适应视图"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="32"
                        Height="32"
                        Click="FitButton_OnClick"
                        FocusVisualStyle="{x:Null}">
                    <materialDesign:PackIcon Kind="FitToPageOutline" Width="18" Height="18"
                                             Foreground="{DynamicResource XScopeTextSecondary}" />
                </Button>
                <Button x:Name="LabelsButton"
                        ToolTip="精简/全部标签"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="32"
                        Height="32"
                        Click="LabelsButton_OnClick"
                        FocusVisualStyle="{x:Null}">
                    <materialDesign:PackIcon Kind="FormatTitle" Width="18" Height="18"
                                             Foreground="{DynamicResource XScopeTextSecondary}" />
                </Button>
                <Button ToolTip="重新布局"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="32"
                        Height="32"
                        Click="RelayoutButton_OnClick"
                        FocusVisualStyle="{x:Null}">
                    <materialDesign:PackIcon Kind="GraphOutline" Width="18" Height="18"
                                             Foreground="{DynamicResource XScopeTextSecondary}" />
                </Button>
            </StackPanel>
        </Border>

        <TextBlock x:Name="InteractHint"
                   Text="左键旋转 · 右键平移 · 滚轮缩放 · 单击查看详情"
                   Margin="16,0,16,16"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   FontSize="11"
                   Foreground="{DynamicResource XScopeTextMuted}"
                   IsHitTestVisible="False"
                   Panel.ZIndex="4"
                   Visibility="Collapsed" />

        <Border x:Name="DetailCard"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="12"
                MaxHeight="320"
                Background="{DynamicResource XScopeSurfaceAlt}"
                BorderBrush="{DynamicResource XScopeBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Panel.ZIndex="20"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="2"
                                  Opacity="0.28"
                                  Color="#000000" />
            </Border.Effect>
            <DockPanel LastChildFill="True" Margin="20,16,20,16">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right"
                            ToolTip="关闭"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Top"
                            Margin="8,-4,-6,0"
                            Click="ClearSelectionButton_OnClick"
                            FocusVisualStyle="{x:Null}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="{DynamicResource XScopeTextSecondary}" />
                    </Button>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="DetailTitle"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                   TextWrapping="Wrap"
                                   LineHeight="24" />
                        <WrapPanel Margin="0,8,0,0">
                            <Border Padding="10,3"
                                    CornerRadius="999"
                                    Background="{DynamicResource XScopeAccentSoft}"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="DetailKind"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeAccentText}" />
                            </Border>
                            <Border x:Name="DetailWeightChip"
                                    Padding="10,3"
                                    CornerRadius="999"
                                    Background="{DynamicResource XScopeHover}"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="DetailWeight"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeTextSecondary}" />
                            </Border>
                            <TextBlock x:Name="DetailId"
                                       FontSize="11"
                                       Foreground="{DynamicResource XScopeTextMuted}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0"
                              Margin="0"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBlock x:Name="AboutHeader"
                                   Text="AI 总结"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="DetailSummary"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <TextBlock x:Name="BodyHeader"
                                   Text="正文"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                   Margin="0,16,0,8" />
                        <TextBlock x:Name="DetailBody"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <TextBlock x:Name="RelationsHeader"
                                   Text="关联"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                   Margin="0,16,0,8" />
                        <ItemsControl x:Name="RelationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="0,10"
                                            BorderBrush="{DynamicResource XScopeBorder}"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding RelationLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource XScopeAccentText}"
                                                       Margin="0,1,12,0"
                                                       MinWidth="36" />
                                            <TextBlock Text="{Binding PeerTitle}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource XScopeTextPrimary}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RelationsEmpty"
                                   Text="暂无关联边"
                                   FontSize="12"
                                   Foreground="{DynamicResource XScopeTextMuted}"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="EmptyHint"
                Background="{DynamicResource XScopeWindowBg}"
                Panel.ZIndex="30"
                Visibility="Visible">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24">
                <TextBlock Text="暂无知识节点"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource XScopeTextPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="有意义、可复用的发现需由模型写入知识关联图。"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource XScopeTextSecondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
