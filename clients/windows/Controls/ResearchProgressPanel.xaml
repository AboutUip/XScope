<UserControl x:Class="XScope.Controls.ResearchProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:XScope.Converters"
             x:Name="Root"
             MinWidth="56"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Right">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBooleanToVisibilityConverter x:Key="InvertBoolToVis" />
        <Style x:Key="RailListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F8F9FA"
            BorderBrush="#E8EAED"
            BorderThickness="1,0,0,0"
            VerticalAlignment="Stretch"
            CornerRadius="12,0,0,12"
            ClipToBounds="True">
        <Grid>
            <!-- Collapsed rail -->
            <Border Padding="8,12"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding IsFeedExpanded, Converter={StaticResource InvertBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Padding="6"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding DataContext.L.ResearchFeedTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="ExpandFeed_OnClick">
                        <materialDesign:PackIcon Kind="ChevronLeft"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#5F6368" />
                    </Button>
                    <Border Margin="0,12,0,0"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="#1A73E8"
                            HorizontalAlignment="Center"
                            Visibility="{Binding RequirementsLocked, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Expanded: top chrome + middle feed (*) + bottom evidence -->
            <DockPanel Width="320"
                       LastChildFill="True"
                       Visibility="{Binding IsFeedExpanded, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,0">
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="6"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Click="CollapseFeed_OnClick"
                                Visibility="{Binding IsRunning, Converter={StaticResource InvertBoolToVis}}">
                            <materialDesign:PackIcon Kind="ChevronRight"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#5F6368" />
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="{Binding DataContext.L.ResearchCancel, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.L.ResearchProgressTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#202124" />
                            <TextBlock Text="{Binding StatusLabel}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#5F6368"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DataContext.L.ResearchKeywordsTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Keywords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6"
                                            Padding="8,4"
                                            Background="#FFFFFF"
                                            BorderBrush="#DADCE0"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Foreground="#202124"
                                                   MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding DataContext.L.ResearchFeedTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#5F6368"
                               Margin="0,0,0,8" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="16,8,16,16"
                        Height="160"
                        Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding DataContext.L.ResearchEvidenceTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,8" />
                        <ListBox x:Name="EvidenceList"
                                 Style="{StaticResource RailListBox}"
                                 ItemsSource="{Binding Evidence}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8"
                                            Background="#FFFFFF"
                                            CornerRadius="8"
                                            BorderBrush="#E8EAED"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#202124"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="#1A73E8"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Snippet}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="#5F6368"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ListBox x:Name="FeedList"
                         Margin="16,0,16,0"
                         Style="{StaticResource RailListBox}"
                         ItemsSource="{Binding Feed}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    Background="#FFFFFF"
                                    CornerRadius="8"
                                    BorderBrush="#E8EAED"
                                    BorderThickness="1">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               FontSize="10"
                                               Foreground="#80868B"
                                               Text="{Binding Meta}"
                                               Margin="8,0,0,0"
                                               MaxWidth="72"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202124"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Body}"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="#5F6368"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
