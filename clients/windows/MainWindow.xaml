<Window x:Class="XScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:XScope.Controls"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        mc:Ignorable="d"
        x:Name="ShellRoot"
        Title="XScope"
        Height="720"
        Width="1200"
        MinHeight="520"
        MinWidth="900"
        Icon="pack://application:,,,/Assets/xscope.ico"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource XScopeTextPrimary}"
        Background="{DynamicResource XScopeSurfaceAlt}"
        BorderBrush="{DynamicResource XScopeSurfaceAlt}"
        BorderThickness="0"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FocusVisualStyle="{x:Null}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Google Drive-like overflow (⋮) on project rows -->
        <Style x:Key="ProjectMoreButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectMoreMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource XScopeSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource XScopeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Opacity="0.18"
                                                  Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectMoreMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource XScopeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="6,1"
                                CornerRadius="6">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectMoreMenuItemDanger" TargetType="MenuItem" BasedOn="{StaticResource ProjectMoreMenuItem}">
            <Setter Property="Foreground" Value="#D93025" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource XScopeSurface}"
                BorderBrush="{DynamicResource XScopeBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,8">
                    <TextBlock Text="XScope"
                               Margin="4,0,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource XScopeTextPrimary}" />
                    <TextBlock Text="{Binding L.MainProjects}"
                               Margin="4,18,0,4"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource XScopeTextSecondary}" />
                </StackPanel>

                <!-- Bottom rail: full-width quiet Google outline -->
                <Button DockPanel.Dock="Bottom"
                        Margin="16,8,16,16"
                        Height="40"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NewProjectCommand}"
                        ToolTip="{Binding L.MainNewProjectTip}"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource XScopeSurfaceAlt}"
                                    BorderBrush="{DynamicResource XScopeBorder}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource XScopeTextSecondary}"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DataContext.L.MainNewProject, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource XScopeTextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeSurface}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource XScopeBorder}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,4,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="24"
                                                Padding="12,10"
                                                Margin="4,0">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XScopeAccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Google-style row: title + overflow menu (⋮) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                 Kind="Pin"
                                                                 Width="12"
                                                                 Height="12"
                                                                 Margin="0,2,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource XScopeAccent}"
                                                                 Visibility="{Binding Pinned, Converter={StaticResource XScopeBoolToVis}}" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                                   TextDecorations="None"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource XScopeTextSecondary}"
                                               TextDecorations="None" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ProjectMoreButton}"
                                        VerticalAlignment="Center"
                                        Click="ProjectMore_OnClick"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{Binding DataContext.L.ProjectMoreTip, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ProjectMoreMenu}">
                                            <MenuItem Style="{StaticResource ProjectMoreMenuItem}"
                                                      Header="{Binding PlacementTarget.Tag.L.ProjectRename, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Style="{StaticResource ProjectMoreMenuItem}"
                                                      Header="{Binding PlacementTarget.Tag.L.ProjectTogglePin, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator Margin="12,4" Background="{DynamicResource XScopeBorder}" />
                                            <MenuItem Style="{StaticResource ProjectMoreMenuItemDanger}"
                                                      Header="{Binding PlacementTarget.Tag.L.ProjectDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <materialDesign:PackIcon Kind="DotsVertical"
                                                             Width="16"
                                                             Height="16"
                                                             Foreground="{DynamicResource XScopeTextSecondary}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource XScopeSurfaceAlt}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Home: ephemeral new project -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="640"
                        Margin="0,0,0,48"
                        Visibility="{Binding IsHome, Converter={StaticResource XScopeBoolToVis}}">
                <TextBlock Text="XScope"
                           FontFamily="Bahnschrift, Segoe UI"
                           FontSize="56"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource XScopeTextPrimary}"
                           Margin="0,0,0,28" />

                <controls:SearchComposePanel />

                <TextBlock Text="{Binding L.MainSearchSub}"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource XScopeTextMuted}" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#D93025"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Research project workspace + insights rail (side-by-side, no overlay) -->
            <Grid Grid.Row="0"
                  Visibility="{Binding IsResearch, Converter={StaticResource XScopeBoolToVis}}"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Main research column: content centers within remaining width -->
                <Grid Grid.Column="0"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      ClipToBounds="True">
                <ScrollViewer x:Name="ResearchWorkspaceScroll"
                              Margin="{Binding ResearchWorkspaceMargin}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,0"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}"
                              PreviewMouseWheel="ResearchWorkspaceScroll_OnPreviewMouseWheel"
                              ScrollChanged="ResearchWorkspaceScroll_OnScrollChanged">
                    <StackPanel MaxWidth="920"
                                HorizontalAlignment="Stretch">
                        <!-- Header -->
                        <TextBlock Text="{Binding L.MainResearchHint}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextMuted}" />
                        <TextBlock Text="{Binding ActiveProjectTitle}"
                                   Margin="0,6,0,0"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,14,0,0">
                            <Border Margin="0,0,8,8"
                                    Padding="10,5"
                                    Background="{DynamicResource XScopeHover}"
                                    CornerRadius="999">
                                <TextBlock FontSize="12" Foreground="{DynamicResource XScopeTextPrimary}">
                                    <Run Text="{Binding ActiveProviderLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Margin="0,0,8,8"
                                    Padding="10,5"
                                    Background="{DynamicResource XScopeHover}"
                                    CornerRadius="999">
                                <TextBlock FontSize="12" Foreground="{DynamicResource XScopeTextPrimary}"
                                           Text="{Binding ActiveModelLabel, Mode=OneWay}" />
                            </Border>
                            <Border Margin="0,0,8,8"
                                    Padding="10,5"
                                    Background="{DynamicResource XScopeAccentSoft}"
                                    CornerRadius="999">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeAccentText}"
                                           Text="{Binding ActivePrecisionLabel, Mode=OneWay}" />
                            </Border>
                        </WrapPanel>

                        <controls:SearchComposePanel Compact="True"
                                                     Margin="0,8,0,28"
                                                     HorizontalAlignment="Stretch"
                                                     Visibility="{Binding Research.ShowTopCompose, Converter={StaticResource XScopeBoolToVis}}" />

                        <!-- Cursor-style conversation stream (from discovery onward) -->
                        <StackPanel Visibility="{Binding Research.ShowChatStream, Converter={StaticResource XScopeBoolToVis}}">
                            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Margin="12,0,0,0"
                                        Padding="12,4"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.Research.CancelCommand, ElementName=ShellRoot}"
                                        Visibility="{Binding DataContext.Research.IsRunning, ElementName=ShellRoot, Converter={StaticResource XScopeBoolToVis}}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="{Binding DataContext.L.ResearchCancel, ElementName=ShellRoot}" />
                                <TextBlock Text="{Binding Research.StatusLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource XScopeTextMuted}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </DockPanel>

                            <ItemsControl x:Name="ResearchChatList"
                                          ItemsSource="{Binding Research.Feed}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,14" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Thinking — Cursor-like assistant prose -->
                                            <StackPanel Visibility="{Binding IsThinking, Converter={StaticResource XScopeBoolToVis}}">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource XScopeTextMuted}"
                                                           Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding Body}"
                                                           FontSize="14"
                                                           LineHeight="22"
                                                           Foreground="{DynamicResource XScopeTextPrimary}"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.92" />
                                            </StackPanel>

                                            <!-- User message -->
                                            <Border Padding="12,10"
                                                    Background="{DynamicResource XScopeAccentSoft}"
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Right"
                                                    MaxWidth="520"
                                                    Visibility="{Binding IsUser, Converter={StaticResource XScopeBoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource XScopeAccentText}"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Body}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource XScopeTextPrimary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Search (hits nested inside, collapsed by default) -->
                                            <Border Padding="12,10"
                                                    Background="{DynamicResource XScopeSurface}"
                                                    BorderBrush="{DynamicResource XScopeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsSearch, Converter={StaticResource XScopeBoolToVis}}">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                                 Kind="Magnify"
                                                                                 Width="16"
                                                                                 Height="16"
                                                                                 Margin="0,1,10,0"
                                                                                 VerticalAlignment="Top"
                                                                                 Foreground="{DynamicResource XScopeTextSecondary}" />
                                                        <StackPanel>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource XScopeTextSecondary}">
                                                                <Run FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Meta}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Body}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                                       Foreground="{DynamicResource XScopeTextPrimary}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Expander Margin="26,8,0,0"
                                                              IsExpanded="{Binding HitsExpanded, Mode=TwoWay}"
                                                              Visibility="{Binding HasHits, Converter={StaticResource XScopeBoolToVis}}">
                                                        <Expander.Header>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource XScopeTextSecondary}"
                                                                       Text="{Binding HitsCountLabel}" />
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Hits}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="10,8"
                                                                            Background="{DynamicResource XScopeSurfaceAlt}"
                                                                            BorderBrush="{DynamicResource XScopeBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource XScopeAccent}"
                                                                                       TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Url}"
                                                                                       Margin="0,2,0,0"
                                                                                       FontSize="11"
                                                                                       Foreground="#188038"
                                                                                       TextWrapping="Wrap"
                                                                                       Visibility="{Binding HasUrl, Converter={StaticResource XScopeBoolToVis}}" />
                                                                            <TextBlock Text="{Binding Snippet}"
                                                                                       Margin="0,4,0,0"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource XScopeTextSecondary}"
                                                                                       TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tool call -->
                                            <Border Padding="12,10"
                                                    Background="{DynamicResource XScopeSurface}"
                                                    BorderBrush="{DynamicResource XScopeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsTool, Converter={StaticResource XScopeBoolToVis}}">
                                                <DockPanel LastChildFill="True">
                                                    <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                             Kind="Console"
                                                                             Width="16"
                                                                             Height="16"
                                                                             Margin="0,1,10,0"
                                                                             VerticalAlignment="Top"
                                                                             Foreground="{DynamicResource XScopeTextSecondary}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Body}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Page hit -->
                                            <Border Padding="12,10"
                                                    Background="{DynamicResource XScopeSurfaceAlt}"
                                                    BorderBrush="{DynamicResource XScopeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsHit, Converter={StaticResource XScopeBoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource XScopeAccent}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Url}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="#188038"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasUrl, Converter={StaticResource XScopeBoolToVis}}" />
                                                    <TextBlock Text="{Binding Body}"
                                                               Margin="0,6,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource XScopeTextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- System note -->
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource XScopeTextMuted}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsSystem, Converter={StaticResource XScopeBoolToVis}}">
                                                <Run FontWeight="SemiBold" Text="{Binding Title}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Body}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Clarify choices (interactive card under the chat) -->
                        <Border Margin="0,16,0,0"
                                Visibility="{Binding Research.ShowClarifyStage, Converter={StaticResource XScopeBoolToVis}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Left"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="{DynamicResource XScopeAccentSoft}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="CrosshairsGps"
                                                                 Width="16"
                                                                 Height="16"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource XScopeAccent}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L.ResearchAskTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource XScopeTextPrimary}" />
                                        <TextBlock Text="{Binding Research.ClarifyPrompt}"
                                                   Margin="0,4,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Research.Choices}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="0"
                                                    MinHeight="0"
                                                    Height="Auto"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Focusable="True"
                                                    Command="{Binding DataContext.Research.ChooseCommand, ElementName=ShellRoot}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chrome"
                                                                Background="{DynamicResource XScopeSurfaceAlt}"
                                                                BorderBrush="{DynamicResource XScopeBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="14,14"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource XScopeAccent}" />
                                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource XScopeAccentSoft}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource XScopeAccentSoft}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource XScopeHover}"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Badge}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource XScopeTextPrimary}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Hint}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource XScopeTextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <materialDesign:PackIcon Grid.Column="2"
                                                                             Kind="ChevronRight"
                                                                             Width="18"
                                                                             Height="18"
                                                                             VerticalAlignment="Center"
                                                                             Margin="8,0,0,0"
                                                                             Foreground="{DynamicResource XScopeBorder}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource XScopeSurface}"
                                        CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L.ResearchAskOrType}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource XScopeTextMuted}"
                                                   Margin="0,0,0,10" />
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Margin="10,0,0,0"
                                                    MinWidth="96"
                                                    Height="40"
                                                    Padding="18,0"
                                                    Command="{Binding DataContext.Research.ContinueCommand, ElementName=ShellRoot}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Content="{Binding DataContext.L.ResearchContinue, ElementName=ShellRoot}" />
                                            <TextBox Text="{Binding DataContext.Research.UserReply, ElementName=ShellRoot, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="False"
                                                     TextWrapping="Wrap"
                                                     MinHeight="40"
                                                     VerticalContentAlignment="Center"
                                                     materialDesign:HintAssist.Hint="{Binding DataContext.L.ResearchReplyHint, ElementName=ShellRoot}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Explicit confirm before deep research -->
                        <Border Margin="0,16,0,0"
                                Padding="20"
                                Background="{DynamicResource XScopeAccentSoft}"
                                BorderBrush="{DynamicResource XScopeBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Visibility="{Binding Research.ShowConfirmStage, Converter={StaticResource XScopeBoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding L.ResearchConfirmTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeAccentText}" />
                                <TextBlock Text="{Binding L.ResearchConfirmPrompt}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource XScopeTextSecondary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Research.SummaryText}"
                                           Margin="0,14,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeTextPrimary}"
                                           TextWrapping="Wrap" />
                                <DockPanel Margin="0,20,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Left"
                                            MinWidth="120"
                                            Height="40"
                                            Padding="20,0"
                                            Command="{Binding DataContext.Research.ConfirmNeedCommand, ElementName=ShellRoot}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="{Binding DataContext.L.ResearchConfirm, ElementName=ShellRoot}" />
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Padding="12,4"
                                            Command="{Binding DataContext.Research.CancelCommand, ElementName=ShellRoot}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="{Binding DataContext.L.ResearchCancel, ElementName=ShellRoot}" />
                                </DockPanel>
                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource XScopeSurfaceAlt}"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding L.ResearchConfirmAdjust}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource XScopeTextMuted}"
                                                   Margin="0,0,0,10" />
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Margin="10,0,0,0"
                                                    MinWidth="96"
                                                    Height="40"
                                                    Padding="18,0"
                                                    Command="{Binding DataContext.Research.ContinueCommand, ElementName=ShellRoot}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Content="{Binding DataContext.L.ResearchContinue, ElementName=ShellRoot}" />
                                            <TextBox Text="{Binding DataContext.Research.UserReply, ElementName=ShellRoot, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="False"
                                                     TextWrapping="Wrap"
                                                     MinHeight="40"
                                                     VerticalContentAlignment="Center"
                                                     materialDesign:HintAssist.Hint="{Binding DataContext.L.ResearchConfirmAdjustHint, ElementName=ShellRoot}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Report at end of chat -->
                        <Border Margin="0,16,0,0"
                                Padding="20"
                                Background="{DynamicResource XScopeSurfaceAlt}"
                                BorderBrush="{DynamicResource XScopeBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Visibility="{Binding Research.HasReport, Converter={StaticResource XScopeBoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding L.ResearchReportTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource XScopeTextSecondary}"
                                           Margin="0,0,0,12" />
                                <!-- Nested FlowDocumentScrollViewer eats wheel; outer PreviewMouseWheel re-routes. -->
                                <mdxam:MarkdownScrollViewer x:Name="ReportMarkdownViewer"
                                                            Markdown="{Binding Research.ReportMarkdown}"
                                                            ClickAction="OpenBrowser"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource XScopeTextPrimary}"
                                                            Background="Transparent"
                                                            Margin="0"
                                                            Padding="0"
                                                            Focusable="False"
                                                            IsTabStop="False"
                                                            VerticalScrollBarVisibility="Disabled"
                                                            HorizontalScrollBarVisibility="Disabled" />
                                <Button Content="{Binding L.ExportReport}"
                                        Command="{Binding ExportReportCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"
                                        Padding="16,4"
                                        Height="36"
                                        IsEnabled="{Binding Research.IsRunning, Converter={StaticResource InvertBooleanConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- Spacer so content can scroll clear of the floating follow-up bar -->
                        <Border Height="96"
                                Visibility="{Binding Research.ShowFollowUpCompose, Converter={StaticResource XScopeBoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Follow-up compose: docked to bottom; fade is decoration-only so it does not steal wheel. -->
                <Grid VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch"
                      Margin="{Binding ResearchFollowUpMargin}"
                      Panel.ZIndex="30"
                      Visibility="{Binding Research.ShowFollowUpCompose, Converter={StaticResource XScopeBoolToVis}}">
                    <Border Margin="0,16,0,0"
                            Background="{DynamicResource XScopeSurfaceAlt}"
                            IsHitTestVisible="False"
                            Focusable="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#B3000000" Offset="0.35" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <controls:SearchComposePanel Compact="True"
                                                 PreferPopupAbove="True"
                                                 Margin="0,16,0,0"
                                                 HorizontalAlignment="Stretch"
                                                 MaxWidth="920"
                                                 MinWidth="480"
                                                 PreviewMouseWheel="FollowUpCompose_OnPreviewMouseWheel" />
                </Grid>
                </Grid>

                <!-- Insights rail: full height to footer; animates width in code-behind -->
                <controls:ResearchSidePanel Grid.Column="1"
                                            DataContext="{Binding SidePanel}"
                                            VerticalAlignment="Stretch"
                                            Margin="0"
                                            Visibility="{Binding DataContext.ShowResearchSidePanel, ElementName=ShellRoot, Converter={StaticResource XScopeBoolToVis}}" />
            </Grid>

            <!-- Shared bottom bar — aligns with right panel edge (no floating gap) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource XScopeSurfaceAlt}"
                    BorderBrush="{DynamicResource XScopeBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10,20,12"
                    Panel.ZIndex="20">
                <StackPanel HorizontalAlignment="Right"
                            Opacity="0.72">
                    <TextBlock Text="{Binding VersionLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource XScopeTextSecondary}"
                               HorizontalAlignment="Right" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource XScopeTextSecondary}"
                               HorizontalAlignment="Right">
                        <Run Text="{Binding L.MainDeveloperPrefix, Mode=OneWay}" />
                        <Run Text="{Binding DeveloperLabel, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="{Binding SettingsButtonMargin}"
                    Width="44"
                    Height="44"
                    Padding="0"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="{Binding L.MainSettingsTip}"
                    Cursor="Hand"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Panel.ZIndex="15"
                    Visibility="{Binding ShowSettingsButton, Converter={StaticResource XScopeBoolToVis}}"
                    Background="{DynamicResource XScopeSurfaceAlt}">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.18"
                                      Color="#000000" />
                </Button.Effect>
                <materialDesign:PackIcon Kind="CogOutline"
                                         Width="24"
                                         Height="24"
                                         Foreground="{DynamicResource XScopeTextSecondary}" />
            </Button>
        </Grid>
    </Grid>
</Window>
